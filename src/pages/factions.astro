---
import { db, Units, Rosters } from 'astro:db';
import ContentLayout from '../layouts/contentLayout.astro';
import Navigation from '../components/Navigation.astro';
import NavCard from '../components/NavCard.astro';
import DataTable from '../components/Table.astro';

const rosters = await db.select().from(Rosters);

const pageTitle = 'Factions';
const siteName = 'Stygmara Campaign';
---

<ContentLayout>
    <div>
        <h1>{pageTitle}</h1>
        <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quia tenetur quidem excepturi quis accusantium vero
            voluptatum temporibus est animi fuga?</p>
        <Navigation>
            <NavCard cardTitle="Imperium of Man" cardLink="/lore/" cardImg="src/assets/Lore.jpg" cardImgAlt=""/>
            <NavCard cardTitle="Tyranids" cardLink="/factions/" cardImg="src/assets/Factions.png" cardImgAlt=""/>
            <NavCard cardTitle="Orks" cardLink="/forces/" cardImg="src/assets/Forces.png" cardImgAlt=""/>
        </Navigation>
    </div>
<div>
    <DataTable
            data={rosters}
            title="Rosters"
            columns={['name', 'faction', 'detachment', 'battleSize', 'createdAt']}
            fancyColumns={['Roster Name', 'Faction', 'Detatchment', 'Size', 'Created']}
    />
</div>
</ContentLayout>