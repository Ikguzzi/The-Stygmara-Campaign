---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Navigation from '../components/Navigation.astro';
import NavCard from '../components/NavCard.astro';
import data from '../../json/Factions.json';

const siteName = 'Stygmara Campaign';
const pageSubtitle = 'The tales and battles from the';

const tabName = 'Home';

---
<Layout pageTitle={siteName}>
    <Banner pageTitle={siteName} pageSubtitle={pageSubtitle}/>
    <Navigation>
        <NavCard cardTitle="Lore" cardLink="/lore/" cardImg="src/assets/Lore.jpg" cardImgAlt=""/>
        <NavCard cardTitle="Campaign Log" cardLink="/battles/" cardImg="src/assets/Battles.png" cardImgAlt=""/>
        <NavCard cardTitle="Rules & Resources" cardLink="/factions/" cardImg="src/assets/Factions.png" cardImgAlt=""/>
    </Navigation>
    <Navigation>
        <NavCard cardTitle="Lore" cardLink="/lore/" cardImg="src/assets/Lore.jpg" cardImgAlt=""/>
        <NavCard cardTitle="Factions" cardLink="/factions/" cardImg="src/assets/Factions.png" cardImgAlt=""/>
        <NavCard cardTitle="Battles" cardLink="/battles/" cardImg="src/assets/Battles.png" cardImgAlt=""/>
        <NavCard cardTitle="Forces" cardLink="/forces/" cardImg="src/assets/Forces.png" cardImgAlt=""/>
        <NavCard cardTitle="Rules" cardLink="/rules/" cardImg="src/assets/Rules.png" cardImgAlt=""/>
    </Navigation>
    <p>{data.rosters.roster.gameSystemName}</p>
</Layout>

