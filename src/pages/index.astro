---
export const prerender = false
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Navigation from '../components/Navigation.astro';
import NavCard from '../components/NavCard.astro';
import data from '../../json/Factions.json';

const siteName = 'Stygmara Campaign';
const pageSubtitle = 'The tales and battles from the';

const tabName = 'Home';

---
<Layout pageTitle={siteName}>
    <Banner pageTitle={siteName} pageSubtitle={pageSubtitle}/>
    <Navigation>
        <NavCard cardTitle="Lore" cardLink="/lore" cardImg="images/Lore.jpg" cardImgAlt=""/>
        <NavCard cardTitle="Campaign Log" cardLink="/battles" cardImg="images/Battles.png" cardImgAlt=""/>
        <NavCard cardTitle="Rules & Resources" cardLink="/factions" cardImg="images/Factions.png" cardImgAlt=""/>
    </Navigation>
    <Navigation>
        <NavCard cardTitle="Lore" cardLink="/lore" cardImg="images/Lore.jpg" cardImgAlt=""/>
        <NavCard cardTitle="Factions" cardLink="/factions" cardImg="images/Factions.png" cardImgAlt=""/>
        <NavCard cardTitle="Battles" cardLink="/battles" cardImg="images/Battles.png" cardImgAlt=""/>
        <NavCard cardTitle="Forces" cardLink="/forces" cardImg="images/Forces.png" cardImgAlt=""/>
        <NavCard cardTitle="Rules" cardLink="/rules" cardImg="images/Rules.png" cardImgAlt=""/>
    </Navigation>
    <p>{data.rosters.roster.gameSystemName}</p>
</Layout>

